# AgriConnect Environment Configuration
# Copy this file to .env and fill in your actual values

# Database
DATABASE_URL=sqlite:///./agriconnect.db
# For PostgreSQL: postgresql://user:password@localhost:5432/agriconnect

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256

# JWT Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_MAX_RESENDS=3
OTP_MAX_FAILED_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=15

# Rate Limiting
MAX_BOOKINGS_PER_DAY=20
MAX_REPORTS_PER_DAY=10

# SMS Gateway (optional, for OTP delivery)
# SMS_PROVIDER=twilio  # or other providers
# SMS_API_KEY=your_api_key
# SMS_API_SECRET=your_api_secret
# SMS_FROM_NUMBER=+1234567890

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development  # or production

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://yourdomain.com

# Admin Configuration
ADMIN_EMAIL=admin@agriconnect.com
